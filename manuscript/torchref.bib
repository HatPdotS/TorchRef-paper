	pages = {1342--1357},
	file = {Full Text PDF:/Users/peter/Zotero/storage/M2VFVXGS/Turk - 2013 - MAIN software for density averaging, model building, structure refinement and validation.pdf:application/pdf},
}
@article{pannu_improved_1996,
	title = {Improved {Structure} {Refinement} {Through} {Maximum} {Likelihood}},
	volume = {52},
	issn = {0108-7673},
	url = {https://journals.iucr.org/a/issues/1996/05/00/li0224/},
	doi = {10.1107/S0108767396004370},
	abstract = {When crystal structures of proteins or small molecules are used to address questions of scientific relevance, the accuracy and precision of the atomic coordinates are crucial. Accordingly, the atomic model is generally improved by refining it to improve agreement with the observed diffraction data. The refinement of crystal structures is conventionally based on least-squares methods but such procedures are handicapped since conditions necessary for the use of the least-squares target are not satisfied. It is proposed here that refinement should be based on maximum likelihood and two maximum-likelihood targets have been implemented in the program XPLOR. Preliminary tests with protein structures give dramatic results. Compared to least-squares refinement, maximum-likelihood refinement can achieve more than twice the improvement in average phase error. The resulting electron-density maps are correspondingly clearer and suffer less from model bias.},
	language = {en},
	number = {5},
	urldate = {2025-11-19},
	journal = {Acta Crystallographica Section A: Foundations of Crystallography},
	publisher = {International Union of Crystallography},
	author = {Pannu, N. S. and Read, R. J.},
	month = sep,
	year = {1996},
	pages = {659--668},
	file = {Full Text PDF:/Users/peter/Zotero/storage/7EW8WQZ7/Pannu und Read - 1996 - Improved Structure Refinement Through Maximum Likelihood.pdf:application/pdf},
}
